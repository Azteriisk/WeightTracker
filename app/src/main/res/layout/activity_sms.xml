<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="32dp">

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/brand_scale_glow"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/goal_notifications"
                android:textColor="@color/neon_teal_bright"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintWidth_max="488dp"
            app:layout_constraintWidth_percent="1.0"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchMetric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/use_metric"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                app:thumbTint="@color/neon_green"
                app:trackTint="@color/card_stroke" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutTargetWeight"
            style="@style/Widget.WeightTracker.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/target_weight_hint"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintWidth_max="488dp"
            app:layout_constraintWidth_percent="1.0"
            app:layout_constraintTop_toBottomOf="@id/cardSwitch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTargetWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:inputType="numberDecimal"
                android:importantForAutofill="no"
                tools:ignore="TextContrastCheck" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTarget"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="@string/save_target_weight"
            android:textColor="#0E1114"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_gradient"
            app:backgroundTint="@null"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintWidth_percent="1.0"
            app:layout_constraintTop_toBottomOf="@id/layoutTargetWeight"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sms_description"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnSaveTarget"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnableSms"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="@string/enable_sms"
            android:textColor="@color/neon_teal_bright"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_secondary"
            app:backgroundTint="@null"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintWidth_percent="1.0"
            app:layout_constraintTop_toBottomOf="@id/textDesc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/status_pending"
            android:textColor="@color/neon_green"
            android:textSize="14sp"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnEnableSms"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>