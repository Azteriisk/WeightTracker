<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="28dp">

            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/brand_scale_glow"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_notifications"
                    android:textColor="@color/neon_teal_bright"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded" />
            </LinearLayout>

            <!-- Unit Preference Card -->
            <LinearLayout
                android:id="@+id/cardSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintWidth_max="488dp"
                app:layout_constraintWidth_percent="1.0"
                app:layout_constraintTop_toBottomOf="@id/headerLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMetric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/use_metric"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:thumbTint="@color/neon_green"
                    app:trackTint="@color/card_stroke" />
            </LinearLayout>

            <!-- Daily Habit Reminder Switch -->
            <LinearLayout
                android:id="@+id/cardReminder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintWidth_max="488dp"
                app:layout_constraintWidth_percent="1.0"
                app:layout_constraintTop_toBottomOf="@id/cardSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDailyReminder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Morning Reminder (8:00 AM)"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:thumbTint="@color/neon_teal"
                    app:trackTint="@color/card_stroke" />
            </LinearLayout>

            <!-- Target Goal Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutTargetWeight"
                style="@style/Widget.WeightTracker.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/target_weight_hint"
                android:layout_marginBottom="14dp"
                app:layout_constraintWidth_max="488dp"
                app:layout_constraintWidth_percent="1.0"
                app:layout_constraintTop_toBottomOf="@id/cardReminder"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTargetWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:inputType="numberDecimal"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Optional Height Input for BMI -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutUserHeight"
                style="@style/Widget.WeightTracker.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Height (inches for BMI)"
                android:layout_marginBottom="16dp"
                app:layout_constraintWidth_max="488dp"
                app:layout_constraintWidth_percent="1.0"
                app:layout_constraintTop_toBottomOf="@id/layoutTargetWeight"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editUserHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:inputType="numberDecimal"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTarget"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="Save Goals &amp; Profile"
                android:textColor="#0E1114"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_gradient"
                app:backgroundTint="@null"
                android:layout_marginBottom="24dp"
                app:layout_constraintWidth_max="320dp"
                app:layout_constraintWidth_percent="1.0"
                app:layout_constraintTop_toBottomOf="@id/layoutUserHeight"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Data Portability (CSV Backup / Restore) -->
            <LinearLayout
                android:id="@+id/cardCsv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"
                app:layout_constraintWidth_max="488dp"
                app:layout_constraintWidth_percent="1.0"
                app:layout_constraintTop_toBottomOf="@id/btnSaveTarget"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATA PORTABILITY (NO PERMISSIONS NEEDED)"
                    android:textColor="#8E9AA8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportCsv"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Export CSV"
                        android:textColor="@color/neon_teal"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_secondary"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImportCsv"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Import CSV"
                        android:textColor="@color/neon_green"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_secondary"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/notification_description"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/cardCsv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/status_enabled"
                android:textColor="@color/neon_green"
                android:textSize="13sp"
                android:textStyle="italic"
                android:gravity="center"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/textDesc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Paywall / In-App Purchase Button ONLY for Ad Removal -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveAds"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="@string/remove_ads"
                android:textColor="@color/neon_teal_bright"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_secondary"
                app:backgroundTint="@null"
                android:layout_marginBottom="24dp"
                app:layout_constraintWidth_max="320dp"
                app:layout_constraintWidth_percent="1.0"
                app:layout_constraintTop_toBottomOf="@id/textStatus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
